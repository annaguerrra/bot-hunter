{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python scripts/build_vercel.py",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,scripts/check*.*,logs/**,data/**,.env*,.venv/**,.git/**,.github/**,docs/**}"
    }
  }
}
