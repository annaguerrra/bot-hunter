# =============================================================
# JOB HUNTER BOT - CONFIGURAÇÕES QUE VOCÊ PODE PERSONALIZAR
# Copie este arquivo como .env. Altere os valores à direita do =
# Não coloque espaços antes/depois do = e não use aspas.
# NUNCA publique o .env: ele contém seus tokens e chaves.
# =============================================================

# ----- 1. FONTES E CANAIS DE NOTIFICAÇÃO (EDITE AQUI) -----
# Chave para consultar vagas no Brasil:
# https://br.jooble.org/api/about
JOOBLE_API_KEY=COLE_A_CHAVE_AQUI

# Ative ou desative cada destino sem modificar o Python.
# Pode deixar AMBOS como true para enviar as mesmas vagas pelos dois canais.
SEND_TELEGRAM=true
SEND_EMAIL=true

# --- TELEGRAM ---
# Crie o bot no https://t.me/BotFather
TELEGRAM_BOT_TOKEN=COLE_O_TOKEN_AQUI

# ID do chat do destinatário (você, seu pai ou um grupo).
# O destinatário precisa iniciar uma conversa com o bot enviando /start.
# Depois execute: python main.py --chat-id
TELEGRAM_CHAT_ID=COLE_O_CHAT_ID_AQUI

# --- E-MAIL (SMTP) ---
# EMAIL_FROM: Gmail que envia as mensagens. Pode ser o seu.
EMAIL_FROM=seuemail@gmail.com

# EMAIL_TO: e-mail de quem recebe, por exemplo o do seu pai.
# Se quiser mais de um: EMAIL_TO=pai@gmail.com;voce@gmail.com
EMAIL_TO=pai@gmail.com

# Use uma SENHA DE APLICATIVO do Google (NÃO a senha comum do Gmail).
# Exige verificação em duas etapas e nem todas as contas têm essa opção.
# https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=COLE_A_SENHA_DE_APLICATIVO_AQUI

# Gmail usa os valores abaixo. Se trocar o provedor, ajuste aqui.
# Este projeto usa conexão SMTP com SSL (porta 465).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ----- 2. CARGOS / ÁREAS (EDITE AQUI) -----
# Separe os cargos usando ; (ponto e vírgula).
# Cada cargo gera uma consulta POR CIDADE. Evite exagerar!
JOB_KEYWORDS=engenheiro de produção;coordenador de produção

# ----- 3. LOCALIZAÇÃO (EDITE AQUI) -----
# Se deseja apenas uma cidade, deixe só JOB_LOCATION.
JOB_LOCATION=Curitiba

# OPCIONAL: várias cidades. Se preencher, substitui JOB_LOCATION.
# Exemplo: JOB_LOCATIONS=Curitiba;Ponta Grossa
JOB_LOCATIONS=

# Distância da cidade em km. Valores aceitos: 0,4,8,16,26,40,80.
JOB_RADIUS=80

# ----- 4. FILTROS DOS RESULTADOS (EDITE AQUI) -----
# Palavras no título que você NÃO deseja (não diferencia acentos).
EXCLUDED_TITLE_TERMS=estágio;estagiário;aprendiz

# OPCIONAL: palavras que DEVEM aparecer no título. Basta UMA bater.
# ATENÇÃO: isso deixa o filtro mais rígido e pode esconder boas vagas.
# Ex.: REQUIRED_TITLE_TERMS=engenheiro;coordenador;gerente;supervisor
REQUIRED_TITLE_TERMS=

# OPCIONAL: empresas cujas vagas você não quer receber.
# Ex.: EXCLUDED_COMPANIES=Empresa X;Empresa Y
EXCLUDED_COMPANIES=

# ----- 5. LIMITES E ECONOMIA DE REQUISIÇÕES -----
# Quantas vagas novas enviar pela CLI por execução (entre 1 e 100).
MAX_JOBS=100

# Proteção: quantas chamadas à Jooble podem acontecer a cada execução.
# Regra: nº de cargos x nº de cidades = consultas por execução.
# Ex.: 2 cargos x 1 cidade = 2 chamadas; 2 x 2 cidades = 4 chamadas.
MAX_QUERIES_PER_RUN=4

# ----- 6. INTERFACE WEB GLOBAL (python web.py) -----
# Google Empregos dentro da interface usa uma conta SerpAPI.
# Obtenha a chave em https://serpapi.com/manage-api-key ou configure pela interface.
SERPAPI_API_KEY=

# Máximo de consultas por cargo/país na Jooble em uma busca da interface.
# Buscas de região/mundo consultam mercados prioritários dentro deste limite.
# Para buscar em qualquer outro país, selecione-o explicitamente na interface.
WEB_MAX_MARKET_QUERIES=6

# A chave antiga JOOBLE_API_KEY é do país abaixo (Brasil por padrão).
# Cada país exige uma chave própria: https://de.jooble.org/api/about etc.
JOOBLE_COUNTRY=BR
# Você também pode cadastrar chaves regionais pela tela Integrações.
# JOOBLE_API_KEY_DE=
# JOOBLE_API_KEY_US=
# Critérios compartilhados: mínimo mensal em reais; salários incertos não geram alertas.
MIN_SALARY_BRL=7000
JOB_PROFILE=both
# Google AI Studio: independente de SerpAPI. Se vazio, fontes existentes continuam funcionando.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Opcional: modelo diferente para a pesquisa Google; vazio usa GEMINI_MODEL.
GEMINI_SEARCH_MODEL=

# Contas web: cadastro aberto por padrão. Feche após criar as contas desejadas.
HUNTER_ALLOW_REGISTRATION=true
# Ative somente quando a interface for servida por HTTPS.
HUNTER_HTTPS=false
HUNTER_TRUSTED_HOSTS=127.0.0.1,localhost,::1
# Opcional: código privado obrigatório para criar a primeira administradora.
HUNTER_SETUP_TOKEN=

# ----- 7. PERSISTENCIA COMPARTILHADA E AUTOMACAO -----
# Conexao Neon privada. Exemplo FICTICIO (substitua pelo seu valor):
# postgresql://usuario:SENHA_FICTICIA@host.example.invalid/neondb?sslmode=require
# Vazio usa SQLite local; com Neon a interface compartilha dados com Actions.
DATABASE_URL=
# Secret no GitHub; JSON regional ficticio, mantenha vazio se usar o painel.
# Exemplo: {"DE":"CHAVE_ALEMA_FICTICIA","NO":"CHAVE_NORUEGUESA_FICTICIA"}
JOOBLE_KEYS_JSON=
# Padrao de pais para contas sem preferencias no agendamento.
JOB_COUNTRY=BR
# Tres chamadas compartilhadas por dia; teto mensal civil de Sao Paulo.
SERPAPI_DAILY_LIMIT=3
SERPAPI_MONTHLY_LIMIT=250
# Gemini opcional: desligado ate voce decidir habilitar.
GEMINI_ENABLED=false
# Alterna fontes sem alterar seus filtros; pode ser desligado no formulário.
AUTO_SOURCE_ROUTING=true
# Permissão separada para orientação com fatos conhecidos, sem pesquisa Google.
# Administração pode habilitar e ajustar as cotas em Integrações; Neon preserva o consumo.
GEMINI_AUTO_FALLBACK=false
GEMINI_AUTO_MODEL=gemini-3.1-flash-lite
# Vazio desliga Google Search automático. Modelos novos não têm grounding gratuito.
# Somente para projetos já elegíveis ao plano gratuito 2.5: gemini-2.5-flash-lite.
GEMINI_AUTO_SEARCH_MODEL=
# Limites conservadores compartilhados entre Vercel e GitHub Actions.
GEMINI_USER_DAILY_LIMIT=2
GEMINI_GLOBAL_DAILY_LIMIT=6
GEMINI_MONTHLY_LIMIT=60
# Reserva conservadora (bytes do prompt + saída máxima), não tokens faturados.
GEMINI_DAILY_TOKEN_BUDGET=100000
# Remetente usa Gmail SMTP SSL; destinatarios ficam nos perfis do Neon.
EMAIL_PROVIDER=smtp
# direct envia pela interface; queue aguarda Actions as 9h17 ou execucao manual.
EMAIL_DELIVERY_MODE=direct
# No workflow este valor e true: Secrets prevalecem sobre chaves no banco.
HUNTER_CONFIG_ENV_PRIORITY=false
# Variable do Actions: false suspende a automacao.
CLOUD_ALERTS_ENABLED=true
# Fuso dos limites diarios. O cron tambem usa America/Sao_Paulo.
HUNTER_BUDGET_TIMEZONE=America/Sao_Paulo
# Opcional: assinatura de sessao; vazia gera chave privada persistente no banco.
HUNTER_SESSION_SECRET=

# ----- 8. INTERFACE PUBLICA NO VERCEL HOBBY -----
# Valores abaixo são para desenvolvimento local. app.py ativa HTTPS, execução
# dentro da requisição e fila de e-mail automaticamente no Vercel.
# DATABASE_URL também deve ser cadastrada no Vercel, no ambiente Production.
HUNTER_SERVERLESS=false
# No Vercel: HUNTER_HTTPS=true e EMAIL_DELIVERY_MODE=queue (padrões de app.py).
# Não cadastre HUNTER_SERVERLESS=false ou HUNTER_HTTPS=false em produção.
# Domínio próprio opcional: HUNTER_TRUSTED_HOSTS=hunter.example.invalid
# VERCEL_URL e VERCEL_PROJECT_PRODUCTION_URL são fornecidos pela plataforma.
# Não escreva credenciais em vercel.json nem em variáveis expostas ao navegador.
## Empresas: limite separado do cadastro (100 por pessoa), de 1 a 20 por busca.
COMPANY_SEARCH_LIMIT=10
